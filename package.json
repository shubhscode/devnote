{
  "name": "devnote",
  "version": "0.2.0",
  "private": true,
  "description": "devnote — open-source, local-first Markdown notebook for developers. No subscription.",
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --filter @devnote/web dev",
    "desktop:install": "bash scripts/install-macos-app.sh",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "lint": "tsc --noEmit -p tsconfig.json",
    "e2e": "pnpm --filter @devnote/web e2e",
    "release": "node scripts/bump-version.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^5.6.2",
    "vitest": "^2.1.3"
  }
}
