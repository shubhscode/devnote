{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevNote",
  "version": "0.3.0",
  "identifier": "dev.devnote.app",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist",
    "beforeDevCommand": "pnpm --filter @devnote/web dev",
    "beforeBuildCommand": "pnpm --filter @devnote/web build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "DevNote",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
